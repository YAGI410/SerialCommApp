<Page
    x:Class="SerialCom.ModbusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:SerialCom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Rectangle Width="15"/>
            <Button x:Name="bConnect" Content="Connect" Click="bConnect_Click"/>
            <Rectangle Width="15"/>
            <Button x:Name="bDisconnect" Content="Disconnect" Click="bDisconnect_Click" IsEnabled="False"/>
            <Rectangle Width="45"/>
            <TextBlock Text="Port:"/>
            <TextBlock x:Name="tbPort" Text=""/>
            <Rectangle Width="20"/>
            <TextBlock Text="Data Bit:"/>
            <TextBlock x:Name="tbDatabit" Text=""/>
            <Rectangle Width="20"/>
            <TextBlock Text="Stop Bit:"/>
            <TextBlock x:Name="tbStopbit" Text=""/>
            <Rectangle Width="20"/>
            <TextBlock Text="Parity:"/>
            <TextBlock x:Name="tbParity" Text=""/>
            <Rectangle Width="20"/>
            <TextBlock Text="BaudRate:"/>
            <TextBlock x:Name="tbBaudrate" Text=""/>
        </StackPanel>

        <!-- 問い合わせ（Modbus RTU） -->
        <Grid Grid.Row="1" BorderBrush="blue" BorderThickness="2" Margin="5" Padding="0,0,0,5">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Request (Modbus RTU)"/>
                <StackPanel Orientation="Horizontal" Margin="5,5,0,0">
                    <muxc:NumberBox x:Name="nbSlave" Header="局番 (1-247)" Value="1" Minimum="1" Maximum="247"
                                    SpinButtonPlacementMode="Inline" Width="130" ValueChanged="NumberBox_ValueChanged"/>
                    <Rectangle Width="15"/>
                    <ComboBox x:Name="cbFunction" Header="ファンクション" Width="200" SelectedIndex="0" SelectionChanged="Request_Changed">
                        <ComboBoxItem Content="03 保持レジスタ読出"/>
                        <ComboBoxItem Content="04 入力レジスタ読出"/>
                    </ComboBox>
                    <Rectangle Width="15"/>
                    <TextBox x:Name="tbStart" Header="開始アドレス (0始まり)" Text="0" Width="150" TextChanged="Request_Changed"/>
                    <Rectangle Width="15"/>
                    <muxc:NumberBox x:Name="nbQuantity" Header="個数 (1-125)" Value="1" Minimum="1" Maximum="125"
                                    SpinButtonPlacementMode="Inline" Width="130" ValueChanged="NumberBox_ValueChanged"/>
                    <Rectangle Width="15"/>
                    <muxc:NumberBox x:Name="nbTimeout" Header="タイムアウト (ms)" Value="500" Minimum="50" Maximum="10000"
                                    SmallChange="50" LargeChange="500" SpinButtonPlacementMode="Inline" Width="150"/>
                </StackPanel>
                <Rectangle Height="10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="tbRequestError" Foreground="Red" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="tbBytes" Text="0" VerticalAlignment="Center"/>
                        <Rectangle Width="5"/>
                        <TextBlock Text="Byte" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <controls:DataGrid x:Name="dataGrid1" Margin="0,5,0,10" HeadersVisibility="Column" AutoGenerateColumns="False"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="sDate" Text="----/--/-- --:--:--" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button x:Name="b1Send" Content="1 Send" VerticalAlignment="Bottom" Click="b1Send_Click"/>
                        <Rectangle Width="50"/>
                        <!-- 連続ポーリング -->
                        <StackPanel Orientation="Horizontal" BorderBrush="PaleGreen" BorderThickness="2" Padding="5">
                            <muxc:NumberBox x:Name="nbPollCount" Header="回数 (0=無制限)" Value="100" Minimum="0" Maximum="1000000"
                                            SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Inline" Width="140"/>
                            <Rectangle Width="10"/>
                            <muxc:NumberBox x:Name="nbPollInterval" Header="間隔 (ms)" Value="500" Minimum="0" Maximum="60000"
                                            SmallChange="50" LargeChange="500" SpinButtonPlacementMode="Inline" Width="130"/>
                            <Rectangle Width="10"/>
                            <Button x:Name="bPollStart" Content="Start" Width="80" VerticalAlignment="Bottom" Click="bPollStart_Click"/>
                            <Rectangle Width="10"/>
                            <Button x:Name="bPollStop" Content="Stop" Width="80" VerticalAlignment="Bottom" Click="bPollStop_Click" IsEnabled="False"/>
                        </StackPanel>
                        <Rectangle Width="5"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- 応答と診断 -->
        <Grid Margin="5" Grid.Row="2" BorderBrush="Orange" BorderThickness="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Response"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="tbRBytes" Text="0" VerticalAlignment="Center"/>
                    <Rectangle Width="5"/>
                    <TextBlock Text="Byte" VerticalAlignment="Center"/>
                    <Button x:Name="bRClear" Content="Clear" Width="100" Margin="10,0,0,0" Click="bRClear_Click"/>
                </StackPanel>
            </Grid>
            <!-- 診断結果 -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="10,5,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="tbResult" Text="-" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="tbResponseTime" Text="" VerticalAlignment="Bottom" Margin="20,0,0,2"/>
                </StackPanel>
                <TextBlock x:Name="tbHint" Text="" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- 統計 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" BorderBrush="Pink" BorderThickness="2" Padding="5,2" Margin="10,8,10,0">
                <TextBlock Text="統計" FontWeight="Bold" Margin="0,0,15,0"/>
                <TextBlock x:Name="tbStatSent" Text="送信 0" Margin="0,0,15,0"/>
                <TextBlock x:Name="tbStatOk" Text="正常 0" Margin="0,0,15,0"/>
                <TextBlock x:Name="tbStatNoResponse" Text="応答なし 0" Margin="0,0,15,0"/>
                <TextBlock x:Name="tbStatCrc" Text="CRC・途切れ 0" Margin="0,0,15,0"/>
                <TextBlock x:Name="tbStatException" Text="例外 0" Margin="0,0,15,0"/>
                <TextBlock x:Name="tbStatOther" Text="その他 0" Margin="0,0,15,0"/>
                <TextBlock x:Name="tbStatErrorRate" Text="エラー率 -" FontWeight="Bold" Margin="0,0,15,0"/>
                <TextBlock x:Name="tbStatTime" Text="応答時間 -"/>
            </StackPanel>
            <!-- 応答フレーム（送信エコーは除く） -->
            <controls:DataGrid x:Name="dataGrid2" Grid.Row="3" Margin="0,10,0,10" HeadersVisibility="Column" AutoGenerateColumns="False"/>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <!-- 読み出し値 -->
                <TextBox x:Name="tbValues" Grid.Column="0" Header="読み出し値" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,5,0"/>
                <!-- 送受信ログ（新しいものが上） -->
                <TextBox x:Name="tbLog" Grid.Column="1" Header="ログ" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </Grid>
            <TextBlock x:Name="rDate" Grid.Row="5" Text="----/--/-- --:--:--" Margin="10,6,0,6"/>
        </Grid>
    </Grid>
</Page>
