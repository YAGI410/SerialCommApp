<Page
    x:Class="SerialCom.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:local="using:SerialCom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Rectangle Width="15"/>
            <Button x:Name="bConnect" Content="Connect" Click="bConnect_Click"/>
            <Rectangle Width="15"/>
            <Button x:Name="bDisconnect" Content="Disconnect"/>
            <Rectangle Width="45"/>
            <TextBlock x:Uid="Port" Text="Port:"/>
            <TextBlock x:Name="tbPort" Text=""/>
            <Rectangle Width="20"/>
            <TextBlock x:Uid="Databit" Text="Data Bit:"/>
            <TextBlock x:Name="tbDatabit" Text=""/>
            <Rectangle Width="20"/>
            <TextBlock x:Uid="Stopbit" Text="Stop Bit:"/>
            <TextBlock x:Name="tbStopbit" Text=""/>
            <Rectangle Width="20"/>
            <TextBlock x:Uid="Paritybit" Text="Parity:"/>
            <TextBlock x:Name="tbParity" Text=""/>
            <Rectangle Width="20"/>
            <TextBlock x:Uid="Baudrate" Text="BaudRate:"/>
            <TextBlock x:Name="tbBaudrate" Text=""/>
        </StackPanel>
        <Grid Grid.Row="1" BorderBrush="blue" BorderThickness="2" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Vertical">
                <TextBlock x:Uid="SendTxt" Text="Sending"/>
                <Grid Height="100">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="tbSending" Grid.Column="1" AcceptsReturn="True"/>
                    <Button Grid.Column="0" x:Name="bText" Content="ASC" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Click="bText_Click"/>
                </Grid>
                <Rectangle Height="10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="tbHex"/>
                        <Button x:Name="bhex" Content="HEX" Click="bhex_Click"/>
                        <Rectangle Width="50"/>
                        <StackPanel Orientation="Horizontal" BorderBrush="PaleGreen" BorderThickness="2">
                            <CheckBox x:Name="cbError" Content="ErrorCheck"/>
                            <TextBox x:Name="tbError1" IsEnabled="False"/>
                            <TextBlock Text="-"/>
                            <TextBox x:Name="tbError2" IsEnabled="False"/>
                        </StackPanel>
                        <Rectangle Width="50"/>
                        <StackPanel Orientation="Horizontal" BorderBrush="Pink" BorderThickness="2">
                            <TextBlock Text="End Code" Margin="5,5,15,0"/>
                            <RadioButton Content="Non" Width="100"/>
                            <RadioButton Content="CR LF" Width="100"/>
                            <RadioButton Content="CR" Width="60"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="tbBytes" Text="0"/>
                        <Rectangle Width="5"/>
                        <TextBlock x:Uid="tbByte" Text="Byte"/>
                        <Button x:Name="bClear" Content="Clear" Width="100" Click="bClear_Click"/>
                    </StackPanel>
                </Grid>
                <Rectangle Height="10"/>
                <controls:DataGrid x:Name="dataGrid1" HeadersVisibility="Column" AutoGenerateColumns="False">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Header="01"/>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </StackPanel>
            <Grid Grid.Row="1" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="500"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="sDate" Text="----/--/-- --:--:--" Margin="10,10,0,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="b1Send" x:Uid="bSend" Content="1 Send" Click="b1Send_Click"/>
                    <Rectangle Width="50"/>
                    <ToggleSwitch x:Uid="tbBat" Header="Batch"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Margin="5" Grid.Row="2" BorderBrush="Orange" BorderThickness="2">
            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                <TextBlock x:Uid="ReciveTxt" Text="Recive"/>
                <controls:DataGrid x:Name="dataGrid2">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Header="01"/>
                        <controls:DataGridTextColumn Header="02"/>
                        <controls:DataGridTextColumn Header="03"/>
                        <controls:DataGridTextColumn Header="04"/>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
                <Rectangle Height="10"/>
                <Grid Height="100">
                    <TextBox Grid.Column="0" AcceptsReturn="True"/>
                </Grid>
                <TextBlock x:Name="rDate" Text="----/--/-- --:--:--" Margin="10,10,0,10"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
