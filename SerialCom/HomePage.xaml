<Page
    x:Class="SerialCom.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:SerialCom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Rectangle Width="15"/>
            <Button x:Name="bConnect" Content="Connect" Click="bConnect_Click"/>
            <Rectangle Width="15"/>
            <Button x:Name="bDisconnect" Content="Disconnect" Click="bDisconnect_Click" IsEnabled="False"/>
            <Rectangle Width="45"/>
            <TextBlock x:Uid="Port" Text="Port:"/>
            <TextBlock x:Name="tbPort" Text=""/>
            <Rectangle Width="20"/>
            <TextBlock x:Uid="Databit" Text="Data Bit:"/>
            <TextBlock x:Name="tbDatabit" Text=""/>
            <Rectangle Width="20"/>
            <TextBlock x:Uid="Stopbit" Text="Stop Bit:"/>
            <TextBlock x:Name="tbStopbit" Text=""/>
            <Rectangle Width="20"/>
            <TextBlock x:Uid="Paritybit" Text="Parity:"/>
            <TextBlock x:Name="tbParity" Text=""/>
            <Rectangle Width="20"/>
            <TextBlock x:Uid="Baudrate" Text="BaudRate:"/>
            <TextBlock x:Name="tbBaudrate" Text=""/>
        </StackPanel>
        <Grid Grid.Row="1" BorderBrush="blue" BorderThickness="2" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Vertical">
                <TextBlock x:Uid="SendTxt" Text="Sending"/>
                <Grid Height="100">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="tbSending" Grid.Column="1" AcceptsReturn="True"/>
                    <Button Grid.Column="0" x:Name="bText" Content="ASC" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Click="bText_Click"/>
                </Grid>
                <Rectangle Height="10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="tbHex" Width="60"/>
                        <Button x:Name="bhex" Content="HEX" Click="bhex_Click"/>
                        <Rectangle Width="30"/>
                        <StackPanel Orientation="Horizontal" BorderBrush="PaleGreen" BorderThickness="2" Padding="5,0">
                            <CheckBox x:Name="cbError" Content="ErrorCheck" MinWidth="0"/>
                            <TextBox x:Name="tbError1" IsEnabled="False" Width="50"/>
                            <TextBlock Text="-" VerticalAlignment="Center" Margin="4,0"/>
                            <TextBox x:Name="tbError2" IsEnabled="False" Width="50"/>
                        </StackPanel>
                        <Rectangle Width="30"/>
                        <StackPanel Orientation="Horizontal" BorderBrush="Pink" BorderThickness="2" Padding="5,0">
                            <TextBlock Text="End Code" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <RadioButton x:Name="rbEndNon" GroupName="EndCode" Content="Non" MinWidth="0" Margin="0,0,12,0" IsChecked="True" Checked="EndCode_Checked"/>
                            <RadioButton x:Name="rbEndCrLf" GroupName="EndCode" Content="CR LF" MinWidth="0" Margin="0,0,12,0" Checked="EndCode_Checked"/>
                            <RadioButton x:Name="rbEndCr" GroupName="EndCode" Content="CR" MinWidth="0" Checked="EndCode_Checked"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="tbBytes" Text="0" VerticalAlignment="Center"/>
                        <Rectangle Width="5"/>
                        <TextBlock x:Uid="tbByte" Text="Byte" VerticalAlignment="Center"/>
                        <Button x:Name="bClear" Content="Clear" Width="100" Margin="10,0,0,0" Click="bClear_Click"/>
                    </StackPanel>
                </Grid>
                <Rectangle Height="10"/>
                <controls:DataGrid x:Name="dataGrid1" HeadersVisibility="Column" AutoGenerateColumns="False">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Header="01"/>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </StackPanel>
            <Grid Grid.Row="1" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="sDate" Text="----/--/-- --:--:--" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="b1Send" x:Uid="bSend" Content="1 Send" VerticalAlignment="Bottom" Click="b1Send_Click"/>
                    <Rectangle Width="50"/>
                    <!-- 連続送信 -->
                    <StackPanel Orientation="Horizontal" BorderBrush="PaleGreen" BorderThickness="2" Padding="5">
                        <muxc:NumberBox x:Name="nbPollCount" Header="回数 (0=無制限)" Value="100" Minimum="0" Maximum="1000000"
                                        SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Inline" Width="140"/>
                        <Rectangle Width="10"/>
                        <muxc:NumberBox x:Name="nbPollInterval" Header="間隔 (ms)" Value="500" Minimum="0" Maximum="60000"
                                        SmallChange="50" LargeChange="500" SpinButtonPlacementMode="Inline" Width="130"/>
                        <Rectangle Width="10"/>
                        <Button x:Name="bPollStart" Content="Start" Width="80" VerticalAlignment="Bottom" Click="bPollStart_Click"/>
                        <Rectangle Width="10"/>
                        <Button x:Name="bPollStop" Content="Stop" Width="80" VerticalAlignment="Bottom" Click="bPollStop_Click" IsEnabled="False"/>
                    </StackPanel>
                    <Rectangle Width="5"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Margin="5" Grid.Row="2" BorderBrush="Orange" BorderThickness="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="ReciveTxt" Text="Recive"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="tbRBytes" Text="0" VerticalAlignment="Center"/>
                    <Rectangle Width="5"/>
                    <TextBlock Text="Byte" VerticalAlignment="Center"/>
                    <Button x:Name="bRClear" Content="Clear" Width="100" Margin="10,0,0,0" Click="bRClear_Click"/>
                </StackPanel>
            </Grid>
            <!-- 最後に受信したフレーム（受信間隔が空いたら次のフレームとみなす） -->
            <controls:DataGrid x:Name="dataGrid2" Grid.Row="1" Margin="0,10,0,10" HeadersVisibility="Column" AutoGenerateColumns="False"/>
            <!-- 送受信ログ（新しいものが上） -->
            <TextBox x:Name="tbLog" Grid.Row="2" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            <TextBlock x:Name="rDate" Grid.Row="3" Text="----/--/-- --:--:--" Margin="10,6,0,6"/>
        </Grid>
    </Grid>
</Page>
